@misc{sanchez-gomezMACLASMineralArchaeological2024,
 abstract = {MACLAS dataset  has been constructed by coupling the elemental and mineral information of (n =1243 samples) from 52 sites in Portugal and Spain in a chronological span from 5th to 3rd millennium BC. Each data point is described by a vector of 45 independent variables with the elemental concentrations expressed in atomic percentages obtained by p-XRF associated with a  single categorical mineral label obtained by XRD as the dependent variable.
This resource, result of a project spanning more than a decade, has been made possible by the hard work, collaborative spirit and open-science vision of many researchers.},
 author = {Sanchez-Gomez, Daniel and Odriozola, Carlos P. and Garrido-Cordero, José Angel and Sousa, Ana Catarina. and Villalobos García, Rodrigo},
 doi = {10.5281/zenodo.15203908},
 file = {Snapshot:/home/dsg/Zotero/storage/9GSZTQZ7/15203908.html:text/html},
 keywords = {Geochemical dataset, Iberian Prehistory, Personal adornments, x-ray diffraction, x-ray fluorescence},
 language = {eng},
 month = {July},
 publisher = {Zenodo},
 title = {MACLAS (Mineral archaeological classification System) Dataset. A geochemical dataset of mineral prehistoric adornments of Iberia},
